   "grammar": {
    "explanation_ko": "매일 반복하는 일은 현재시제로 말합니다. always(항상)·usually(보통)·often(자주)·sometimes(가끔)·never(전혀 ~않다) 같은 빈도부사는 보통 일반동사 앞, be동사 뒤에 둡니다.",
    "common_mistake_ko": "I go always to school.(X) → I always go to school.(O) / be동사는 She is always late.처럼 뒤에 둡니다."
   },
   "vocabulary": [
    {
     "word": "always",
     "part_of_speech": "부사",
     "meaning_ko": "항상",
     "example_en": "I always eat breakfast.",
     "example_ko": "나는 항상 아침을 먹어요."
    },
    {
     "word": "usually",
     "part_of_speech": "부사",
     "meaning_ko": "보통",
     "example_en": "She usually walks to work.",
     "example_ko": "그녀는 보통 걸어서 출근해요."
    },
    {
     "word": "often",
     "part_of_speech": "부사",
     "meaning_ko": "자주",
     "example_en": "We often play soccer.",
     "example_ko": "우리는 자주 축구를 해요."
    },
    {
     "word": "sometimes",
     "part_of_speech": "부사",
     "meaning_ko": "가끔",
     "example_en": "He sometimes cooks dinner.",
     "example_ko": "그는 가끔 저녁을 요리해요."
    },
    {
     "word": "never",
     "part_of_speech": "부사",
     "meaning_ko": "전혀 ~않다",
     "example_en": "I never drink coffee.",
     "example_ko": "나는 커피를 전혀 마시지 않아요."
    },
    {
     "word": "get up",
     "part_of_speech": "동사구",
     "meaning_ko": "일어나다",
     "example_en": "I get up at seven.",
     "example_ko": "나는 7시에 일어나요."
    }
   ],
   "examples": [
