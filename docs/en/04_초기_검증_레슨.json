        {
          "id": "P002-Q3",
          "type": "single_choice",
          "stem": "They ___ ready.",
          "choices": [
            "is",
            "are",
            "am"
          ],
          "answer_index": 1,
          "explanation_ko": "they는 복수 취급이므로 are를 씁니다.",
          "error_tag": "be-agreement"
        }
      ],
      "output_task": {
        "prompt_ko": "I am 또는 She is를 사용해 문장 한 개를 만드세요.",
