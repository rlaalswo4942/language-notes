      "id": "B1-001",
      "publish_date": "2026-10-12",
      "level": "B1",
      "track": "general",
      "day": 1,
      "title_ko": "because와 although의 차이",
      "objective_ko": "이유와 양보를 표현하는 연결어를 구별한다.",
      "estimated_minutes": 25,
      "reference_sources": [
        {
          "url": "https://learnenglish.britishcouncil.org/free-resources/grammar/b1-b2",
          "publisher": "British Council",
          "checked_at": "2026-10-12",
          "supports": "문법 학습 주제"
        }
      ],
      "content_kind": "original_practice",
      "review_status": "verified",
      "grammar": {
        "explanation_ko": "because는 이유(~이기 때문에)를, although는 예상과 다른 사실(~이지만)을 연결합니다. 두 접속사는 문맥이 다릅니다.",
        "common_mistake_ko": "Although 뒤에는 보통 절(주어+동사)을 사용하며, Although A, but B처럼 한 문장에서 although와 but을 중복하지 않는 것이 일반적입니다."
      },
      "vocabulary": [
        {
          "word": "because",
          "part_of_speech": "접속사",
          "meaning_ko": "~이기 때문에",
          "example_en": "I stayed home because I was sick.",
          "example_ko": "아파서 집에 있었어요."
        },
        {
          "word": "although",
          "part_of_speech": "접속사",
          "meaning_ko": "~이지만",
          "example_en": "Although it rained, we walked.",
          "example_ko": "비가 왔지만 우리는 걸었어요."
        },
        {
          "word": "reason",
          "part_of_speech": "명사",
          "meaning_ko": "이유",
          "example_en": "Tell me the reason.",
          "example_ko": "이유를 말해 주세요."
        },
        {
          "word": "weather",
          "part_of_speech": "명사",
          "meaning_ko": "날씨",
          "example_en": "The weather is good.",
          "example_ko": "날씨가 좋아요."
        }
      ],
      "examples": [
        {
          "en": "I went home because I was tired.",
          "ko": "피곤했기 때문에 집에 갔어요."
        },
        {
          "en": "Although I was tired, I finished the task.",
          "ko": "피곤했지만 그 일을 끝냈어요."
        }
      ],
      "questions": [
        {
          "id": "B1001-Q1",
          "type": "single_choice",
          "stem": "I was late ___ the bus was delayed.",
          "choices": [
            "although",
            "because",
            "unless"
          ],
          "answer_index": 1,
          "explanation_ko": "버스가 늦은 이유를 설명하므로 because입니다.",
          "error_tag": "conjunction"
