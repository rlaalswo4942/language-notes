            "You",
            "We"
          ],
          "answer_index": 0,
          "explanation_ko": "she는 여성 한 사람을 가리키는 주어입니다.",
          "error_tag": "pronoun"
        },
        {
          "id": "P001-Q3",
          "type": "single_choice",
          "stem": "영어에서 I의 올바른 표기는?",
          "choices": [
            "i",
            "I"
          ],
          "answer_index": 1,
          "explanation_ko": "인칭대명사 I는 항상 대문자입니다.",
          "error_tag": "capitalization"
        }
      ],
      "output_task": {
        "prompt_ko": "I 또는 You로 시작하는 영어 문장 한 개를 만들어 보세요.",
