          "answer_index": 0,
          "explanation_ko": "추운 상황에도 밖에 나갔다는 양보 의미입니다.",
          "error_tag": "conjunction"
        },
        {
          "id": "B1001-Q3",
          "type": "single_choice",
          "stem": "두 절이 대조되도록 이어 주는 단어는?",
          "choices": [
            "although",
            "because"
          ],
          "answer_index": 0,
          "explanation_ko": "although는 ~이지만의 대조 관계를 만듭니다.",
          "error_tag": "meaning"
        }
      ],
      "output_task": {
        "prompt_ko": "because와 although를 사용해 각 한 문장씩 써 보세요.",
        "example_answer_en": "",
        "note_ko": "예시 정답만 가능한 것은 아닙니다. 직접 만든 문장의 맥락을 확인하세요."
      },
