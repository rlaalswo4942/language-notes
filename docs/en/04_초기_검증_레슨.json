      ],
      "content_kind": "original_practice",
      "review_status": "verified",
      "grammar": {
        "explanation_ko": "현재의 상태·신분 등을 말할 때 be동사를 사용합니다. I 뒤에는 am, he/she/it 뒤에는 is, you/we/they 뒤에는 are를 사용합니다.",
        "common_mistake_ko": "I is, He are, You am은 잘못된 조합입니다."
      },
      "vocabulary": [
        {
          "word": "happy",
          "part_of_speech": "형용사",
          "meaning_ko": "행복한",
          "example_en": "I am happy.",
          "example_ko": "나는 행복해요."
        },
        {
          "word": "busy",
          "part_of_speech": "형용사",
          "meaning_ko": "바쁜",
          "example_en": "He is busy.",
          "example_ko": "그는 바빠요."
        },
        {
          "word": "ready",
          "part_of_speech": "형용사",
          "meaning_ko": "준비된",
          "example_en": "We are ready.",
          "example_ko": "우리는 준비됐어요."
        },
        {
          "word": "tired",
          "part_of_speech": "형용사",
          "meaning_ko": "피곤한",
          "example_en": "She is tired.",
          "example_ko": "그녀는 피곤해요."
        }
      ],
      "examples": [
        {
          "en": "I am ready.",
          "ko": "나는 준비됐어요."
        },
        {
          "en": "They are busy.",
          "ko": "그들은 바빠요."
        }
      ],
      "questions": [
        {
          "id": "P002-Q1",
          "type": "single_choice",
          "stem": "I ___ happy.",
          "choices": [
            "is",
            "am",
            "are"
          ],
          "answer_index": 1,
          "explanation_ko": "I와 쓰이는 be동사의 현재형은 am입니다.",
          "error_tag": "be-agreement"
