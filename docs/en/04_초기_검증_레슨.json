      "day": 1,
      "title_ko": "영어 문장의 주인공: I, you, he, she",
      "objective_ko": "사람을 가리키는 기본 주어를 구별한다.",
      "estimated_minutes": 25,
      "reference_sources": [
        {
          "url": "https://learnenglish.britishcouncil.org/free-resources/grammar/a1-a2",
          "publisher": "British Council",
          "checked_at": "2026-10-12",
          "supports": "문법 학습 주제"
        }
      ],
      "content_kind": "original_practice",
      "review_status": "verified",
      "grammar": {
        "explanation_ko": "I는 나, you는 너/당신, he는 그, she는 그녀를 가리키는 인칭대명사입니다. 영어에서 주어는 보통 동사 앞에 놓입니다.",
        "common_mistake_ko": "I는 문장 중간에 있어도 대문자로 씁니다."
      },
      "vocabulary": [
        {
          "word": "I",
          "part_of_speech": "대명사",
          "meaning_ko": "나",
          "example_en": "I am here.",
          "example_ko": "나는 여기 있어요."
        },
        {
          "word": "you",
          "part_of_speech": "대명사",
          "meaning_ko": "너/당신",
          "example_en": "You are kind.",
          "example_ko": "너는 친절해요."
        },
        {
          "word": "he",
          "part_of_speech": "대명사",
          "meaning_ko": "그",
          "example_en": "He is a student.",
          "example_ko": "그는 학생이에요."
        },
        {
          "word": "she",
          "part_of_speech": "대명사",
          "meaning_ko": "그녀",
          "example_en": "She is happy.",
          "example_ko": "그녀는 행복해요."
        }
      ],
      "examples": [
        {
          "en": "I am a student.",
          "ko": "나는 학생이에요."
        },
        {
          "en": "She is here.",
          "ko": "그녀는 여기 있어요."
        }
      ],
      "questions": [
        {
          "id": "P001-Q1",
          "type": "single_choice",
          "stem": "‘나’를 나타내는 영어 단어는?",
          "choices": [
            "He",
            "I",
            "She",
            "You"
          ],
          "answer_index": 1,
          "explanation_ko": "I는 말하는 사람 자신을 가리킵니다.",
          "error_tag": "pronoun"
        },
        {
          "id": "P001-Q2",
          "type": "single_choice",
          "stem": "빈칸: ___ is a student. (그녀는 학생이에요.)",
          "choices": [
            "She",
