          "part_of_speech": "형용사",
          "meaning_ko": "추운/차가운",
          "example_en": "It is not cold.",
          "example_ko": "날씨가 춥지 않아요."
        },
        {
          "word": "hungry",
          "part_of_speech": "형용사",
          "meaning_ko": "배고픈",
          "example_en": "We are not hungry.",
          "example_ko": "우리는 배고프지 않아요."
        }
      ],
      "examples": [
